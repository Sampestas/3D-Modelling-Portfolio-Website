<file path="css/base.css">
html {
    font-size: clamp(14px, 0.5vw + 12px, 18px);
    box-sizing: border-box;
    scroll-behavior: smooth;
}

* {
  margin: 0;
  padding: 0;
}

*, *:before, *:after {
    box-sizing: inherit;
}

body {
    background-color: var(--bg-main);
    color: var(--colors-main-text);
    margin: 0;
    min-height: 100vh;
    overflow-x: hidden;
    overflow-y: auto;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    touch-action: manipulation; 
}

section {
    padding: 120px 2rem 60px 2rem;
    min-height: 100vh;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    box-sizing: border-box;
}
