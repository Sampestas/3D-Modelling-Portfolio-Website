<file path="css/components/pipeline.css">
.pipeline-container {
    display: flex;
    gap: 2.5rem;
    width: 100%;
    align-items: stretch;
}

.pipeline-bar {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
}

.pipeline-step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 2rem 1rem;
    background-color: var(--bg-card);
    border: 2px solid rgba(255, 255, 255, 0.03);
    border-radius: 15px;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
}

.pipeline-step.active {
    border-color: var(--colors-accent-dark);
    background-color: rgba(201, 118, 240, 0.05);
}

.step-num {
    font-size: 1.2rem;
    font-weight: bold;
    color: var(--colors-accent);
    line-height: 1.2;
}

.step-content h3 {
    font-size: 1.25rem;
    color: var(--colors-main-text);
    margin-bottom: 0.25rem;
}

.step-content p {
    color: var(--colors-sub-text);
    font-size: 0.95rem;
    line-height: 1.5;
}

.pipeline-viewport {
    position: relative;
    flex: 1.5;
    background-color: var(--bg-card-render);
    border: 2px solid rgba(255, 255, 255, 0.03);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
}

.pipeline-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.3s ease-in-out;
}

.pipeline-container:not([data-active-stage]) .img-1,
.pipeline-container[data-active-stage="1"] .img-1,
.pipeline-container[data-active-stage="2"] .img-2,
.pipeline-container[data-active-stage="3"] .img-3,
.pipeline-container[data-active-stage="4"] .img-4 {
    opacity: 1;
    z-index: 3;
}
</file>

<file path="css/components/portfolio.css">
.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 17.5rem;
    gap: 1.5rem;
    width: 100%;
}

.bento-item {
    background-color: var(--bg-card);
    border-radius: 15px;
    overflow: hidden;
    position: relative;
    border: 2px solid rgba(255, 255, 255, 0.03);
    display: flex;
    flex-direction: column;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
}

.bento-item.wide {
    grid-column: span 2;
}

.bento-item.tall {
    grid-row: span 2;
}

.bento-item.interactive-wire .card-media img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    object-position: center 20%;
    transform: scale(0.97);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
}

.bento-item.interactive-wire .card-media {
    background-color: var(--bg-card-render);
}

.interactive-wire .render-view {
    opacity: 1;
    z-index: 1;
    transition: opacity 0.3s ease;
}

.interactive-wire .wire-view {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.3s ease;
}

.interactive-wire.active-tap .render-view {
    opacity: 0;
}

.interactive-wire.active-tap .wire-view {
    opacity: 1;
}

.card-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--bg-card-image);
}

.card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
}

.item-dual-layer {
    position: relative;
}

.item-dual-layer .wire-view {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 2;
}

.card-info {
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(11, 7, 17, 0.95) 0%, rgba(11, 7, 17, 0.4) 60%, rgba(11, 7, 17, 0) 100%);
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    z-index: 5;
}

.card-info .category {
    font-family: Verdana, Geneva, Tahoma, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--colors-accent);
    font-weight: 700;
    margin-bottom: 0.25rem;
    display: inline-block;
}

.card-info h3 {
    font-size: 1.2rem;
    color: var(--colors-main-text);
}
</file>

