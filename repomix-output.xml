<file path="css/elements.css">
.site-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem 1rem;
  padding: 1rem 5%;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 1000;
  box-sizing: border-box;
  
  background-color: var(--black-matte);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 0.25rem 2rem rgba(0, 0, 0, 0.2);
}

.brand-link {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  transition: transform 0.3s ease;
}

.logo-img {
  height: clamp(2.5rem, 5vw, 3.5rem);
  width: auto;
  object-fit: contain;
}

.nickname {
  display: inline-block;
  color: var(--colors-main-text);
  font-size: clamp(1.4rem, 4vw, 2.2rem);
  font-weight: bold;
  transition: color 0.4s ease;
}

.nav-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: clamp(0.75rem, 2vw, 2.5rem);
}

.nav-link {
  display: inline-block;
  color: var(--colors-main-text);
  text-decoration: none;
  font-size: clamp(0.85rem, 2vw, 1.3rem);
  font-weight: 500;
  transition: color 0.4s ease, transform 0.3s ease;
  white-space: nowrap;
}

.brand-link:active,
.nav-link:active {
  transform: scale(0.98);
}
.brand-link:active .nickname {
  color: var(--colors-accent-dark);
}
.nav-link:active {
  color: var(--colors-accent-dark);
}


section {
  padding: 8.75rem 2rem 5rem 2rem;
  min-height: 100vh;
  box-sizing: border-box;
  scroll-margin-top: 2rem; 
}

hr.gradient {
  border: 0;
  height: 4px;
  width: 80%;
  margin: 0.5rem auto;
  background-color: var(--colors-divider); 
  mask-image: linear-gradient(to right, transparent 0%, black 25%, black 75%, transparent 100%);
  -webkit-mask-image: linear-gradient(to right, transparent 0%, black 25%, black 75%, transparent 100%);
}

mark {
    background-color: var(--colors-accent-dark);
    color: var(--colors-main-text);
    padding: 0.2rem 0.4rem;
    border-radius: 6px;
    font-weight: bold;  
    display: inline-block;
    line-height: 1;
}
.highlight {
    color: var(--colors-accent);
}

.section-header {
    margin-bottom: 3rem;
    text-align: left;
}

.section-header h2 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.5rem;
}

.section-header p {
    color: var(--colors-sub-text);
    font-size: 1.1rem;
}

.bento-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 17.5rem;
    gap: 1.5rem;
    width: 100%;
}

.bento-item {
    background-color: var(--bg-card);
    border-radius: 15px;
    overflow: hidden;
    position: relative;
    border: 2px solid rgba(255, 255, 255, 0.03);
    display: flex;
    flex-direction: column;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
}

.bento-item.wide {
    grid-column: span 2;
}

.bento-item.tall {
    grid-row: span 2;
}

.bento-item.interactive-wire .card-media img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    
    object-position: center 20%; 
    
    transform: scale(0.97);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
    pointer-events: none;
    -webkit-user-drag: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
}

.bento-item.interactive-wire .card-media {
    background-color: #3b3b3b;
}


.interactive-wire .render-view {
    opacity: 1;
    z-index: 1;
    transition: opacity 0.3s ease;
}

.interactive-wire .wire-view {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 2;
    transition: opacity 0.3s ease;
}

.interactive-wire.active-tap .render-view {
    opacity: 0;
}

.interactive-wire.active-tap .wire-view {
    opacity: 1;
}


.card-media {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: var(--bg-card-image);
}

.card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
}

.item-dual-layer {
    position: relative;
}
.item-dual-layer .wire-view {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 2;
}
.interactive-wire.active-tap .wire-view {
    opacity: 1;
}

.card-info {
    padding: 1.5rem;
    background: linear-gradient(to top, rgba(11, 7, 17, 0.95) 0%, rgba(11, 7, 17, 0.4) 60%, rgba(11, 7, 17, 0) 100%);
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    box-sizing: border-box;
    z-index: 5;
}

.card-info .category {
    font-family: cursive, 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--colors-accent);
    font-weight: 700;
    margin-bottom: 0.25rem;
    display: inline-block;
}

.card-info h3 {
    font-size: 1.2rem;
    color: var(--colors-main-text);
}


.site-footer {
    background-color: var(--bg-card);
    border-top: 1px solid var(--colors-divider);
    padding: 2.5rem 2rem;
    margin-top: 4rem;
    width: 100%;
    font-weight: bold;
}

.footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
}

.alias-footer {
    color: var(--colors-sub-text);
    font-size: 0.95rem;
}

.social-links {
    display: flex;
    align-items: center;
    gap: 2rem;
}

.social-links a {
    color: var(--colors-main-text);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    transition: color 0.4s ease, transform 0.3s ease;
    display: inline-block;
}

.social-links a:active {
    color: var(--colors-accent-dark);
    transform: scale(0.98);
}



.about-layout {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: start;
    max-width: 1200px;
}

.about-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--colors-sub-text);
}

.about-text p {
    margin-bottom: 1.5rem;
}

.about-skills h3 {
    font-size: 1.4rem;
    margin-bottom: 1rem;
    color: var(--colors-main-text);
}

.skills-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.skills-list li {
    font-size: 1rem;
    color: var(--colors-sub-text);
    padding-left: 1rem;
    border-left: 2px solid var(--colors-accent);
}

.skills-list li strong {
    color: var(--colors-main-text);
}



.services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    width: 100%;
}

.service-card {
    background-color: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.03);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
}

#service-card-1 {
    height: 20rem;
}

#service-card-2 {
    height: 25rem;
}

#service-card-3 {
    height: 30rem;
}

.service-icon-wrapper {
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

.service-card h3 {
    font-size: 1.4rem;
    color: var(--colors-main-text);
}

.service-card p {
    color: var(--colors-sub-text);
    font-size: 1rem;
    line-height: 1.6;
}


@media (hover: hover) and (pointer: fine) {

    .brand-link:hover .nickname,
    .nav-link:hover {
        color: var(--colors-accent);
    }

    .brand-link:hover,
    .nav-link:hover {
        transform: scale(1.03);
    }

    .bento-item:hover {
        transform: translateY(-5px);
        border-color: var(--bg-card-hover);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    }

    .bento-item:hover .card-media img:not(.wire-view) {
        transform: scale(1.04);
    }

    .bento-item.interactive-wire:hover .card-media img:not(.wire-view) {
        transform: scale(0.99);
    }

    .interactive-wire:hover .render-view {
        opacity: 0;
    }

    .interactive-wire:hover .wire-view {
        opacity: 1;
    }

    .social-links a:hover {
        color: var(--colors-accent);
        transform: scale(1.03);
    }

    .service-card:hover {
        transform: translateY(-5px);
        border-color: var(--bg-card-hover);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    }
}


@media (max-width: 900px) {
    .bento-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 15rem;
    }
    .bento-item.wide {
        grid-column: span 2;
    }
    .about-layout {
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    .services-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    .bento-grid {
        grid-template-columns: 1fr;
        grid-auto-rows: 13.75rem;
    }

    .bento-item.wide,
    .bento-item.tall {
        grid-column: span 1;
        grid-row: span 1;
    }

    section {
        padding: 8rem 1rem 2.5rem 1rem;
    }

    .site-header {
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
    }

    .nav-list {
        gap: 1rem;
    }

    .footer-container {
        flex-direction: column-reverse;
        text-align: center;
        gap: 1.25rem;
    }

    .social-links {
        width: 100%;
        justify-content: center;
        gap: 1.5rem;
    }

    .services-grid {
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }
    
    .service-card {
        padding: 2rem 1.5rem;
    }
}
